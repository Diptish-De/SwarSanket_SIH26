# SwarSanket frontend (Vite) - copy to .env.local for local overrides.
# Every value here is public: it ships inside the browser bundle.

# Screening backend. Leave unset to use the Render deployment in production
# builds and http://127.0.0.1:8001 in development.
# VITE_API_BASE_URL=https://sih-26-swarsanket-backend.onrender.com

# Supabase Realtime for live screening progress. Optional: when unset, the
# backend's POST /api/screenings response supplies its own project URL and
# anon key, so a fresh deployment needs nothing here. Set these only to point
# the frontend at a different Supabase project than the backend uses.
# The anon key is designed to be public; row access is governed by RLS.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
