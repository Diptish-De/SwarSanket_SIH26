# Server Configuration
BACKEND_HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
DEBUG=true

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8443,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8443

# Ephemeral Upload Storage Path
UPLOADS_DIR=/tmp/swarsanket_uploads

# Faster-Whisper Model ("tiny" is default for Render memory constraints)
SWARSANKET_WHISPER_MODEL=tiny

# Supabase Cloud Integration (Optional / Cloud Persistence)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_STORAGE_BUCKET=swarsanket-recordings
USE_SUPABASE_STORAGE=true
USE_SUPABASE_DB=true
