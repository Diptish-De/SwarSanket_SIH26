# Server Configuration
BACKEND_HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
DEBUG=true

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8443,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8443

# Ephemeral Upload Storage Path
